# AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face Settings (Required only by Frontend/Proxy if HF Space is Private)
HF_TOKEN=your_hf_access_token_here

# Supabase Credentials (Used by Frontend for browse/metadata)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Backend API Configuration
# Local development default: http://localhost:7860
# Production: https://<username>-<space-name>.hf.space
CHAT_API_URL=http://localhost:7860
